# Supabase contact form backend.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here

# Optional. If set, the React form calls this Supabase Edge Function instead
# of inserting directly into the leads table.
VITE_SUPABASE_LEAD_FUNCTION=submit-lead
VITE_SUPABASE_VOICE_FUNCTION=request-voice-call

# Browser-safe ElevenLabs agent id for in-page voice chat.
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Server-only ElevenLabs credentials for outbound AI calling.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Mobile outbound calling via ElevenLabs.
# Use exotel for India-friendly mobile calling, sip_trunk for a BYO SIP trunk,
# or whatsapp only if you intentionally want WhatsApp permission-request calling.
ELEVENLABS_CALL_PROVIDER=exotel
ELEVENLABS_AGENT_PHONE_NUMBER_ID=your_elevenlabs_phone_number_or_sip_trunk_id_here

# Optional WhatsApp outbound calling via ElevenLabs.
ELEVENLABS_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
ELEVENLABS_WHATSAPP_TEMPLATE_NAME=your_approved_template_name_here
ELEVENLABS_WHATSAPP_TEMPLATE_LANGUAGE_CODE=en

# Website endpoint protection for voice/Supabase Edge Functions.
# Comma-separated list. Keep production domains here after launch.
VOICE_ALLOWED_ORIGINS=https://uprankdigital.com,https://www.uprankdigital.com
VOICE_DEFAULT_COUNTRY_CODE=91

# Supabase Edge Function secrets. Set these in Supabase, not in browser builds.
CONTACT_ALLOWED_ORIGINS=https://uprankdigital.com,https://www.uprankdigital.com
CONTACT_RECIPIENT=sachin@uprankdigital.com
RESEND_API_KEY=your_resend_api_key_for_edge_function_only
RESEND_FROM_EMAIL=Up Rank Digital <leads@uprankdigital.com>

# BigRock FTP/FTPS deployment credentials.
# Use the exact FTP host/user from BigRock cPanel. Prefer FTPS when available.
FTP_HOST=ftp.yourdomain.com
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_REMOTE_PATH=/public_html
FTP_PORT=21
FTP_SECURE=true
FTP_VERBOSE=false
