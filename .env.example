# Supabase contact form backend.
VITE_SUPABASE_URL=https://your_supabase_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here

# Optional. If set, the React form calls this Supabase Edge Function instead
# of inserting directly into the leads table.
VITE_SUPABASE_LEAD_FUNCTION=submit-lead

# Text AI assistant backend.
VITE_SUPABASE_CHAT_FUNCTION=chat

# LiveKit voice assistant backend.
VITE_LIVEKIT_URL=wss://your-livekit-url
# e.g., https://[PROJECT_REF].supabase.co/functions/v1/livekit-token
VITE_LIVEKIT_TOKEN_ENDPOINT=https://your-backend.com/api/livekit-token
# Supabase Edge Function secrets. Set these in Supabase, not in browser builds.
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
CONTACT_ALLOWED_ORIGINS=https://uprankdigital.com,https://www.uprankdigital.com
CHAT_ALLOWED_ORIGINS=https://uprankdigital.com,https://www.uprankdigital.com
CONTACT_RECIPIENT=sachin@uprankdigital.com
RESEND_API_KEY=your_resend_api_key_for_edge_function_only
RESEND_FROM_EMAIL=Up Rank Digital <leads@uprankdigital.com>

# Supabase chat Edge Function secrets. Set these in Supabase, not in browser builds.
CEREBRAS_API_KEY=your_cerebras_api_key_for_edge_function_only
CEREBRAS_MODEL=llama3.1-8b

